# ---------------------------------------------------------------------------
# MicanyTradx environment configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env to git.
# ---------------------------------------------------------------------------

# PostgreSQL connection string from Neon (Step 2 of setup).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Server
PORT=3000

# Trading engine configuration (optional overrides)
SYMBOL=btcusdt
TIMEFRAME=15m

# Binance Testnet Credentials
# Get yours at https://testnet.binance.vision/
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# CORS: comma-separated allowlist of browser origins (your deployed dashboard).
# Leave blank for permissive local development.
CORS_ORIGINS=https://micanytradx.vercel.app

# ==========================================
# NOTIFICATIONS (Phase G)
# ==========================================
# Telegram: create a bot via @BotFather, then get the token + your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: create a webhook in a private channel and paste its URL.
DISCORD_WEBHOOK_URL=

# Toggle specific notifications ('false' to disable). Risk-halt and
# infrastructure alerts are always on.
NOTIFY_ON_SIGNAL=true
NOTIFY_ON_TRADE=true
NOTIFY_ON_TRAILING=true
BINANCE_TESTNET=true
