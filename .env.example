# ---------------------------------------------------------------------------
# MicanyTradx environment configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env to git.
# ---------------------------------------------------------------------------

# PostgreSQL connection string from Neon (Step 2 of setup).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Trading engine configuration (optional overrides)
SYMBOL=btcusdt
TIMEFRAME=15m
